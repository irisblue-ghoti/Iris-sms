# Database (PostgreSQL - 可使用 Vercel Postgres, Supabase, Neon, PlanetScale 等)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret-key"
NEXTAUTH_URL="https://your-domain.vercel.app"

# Tiger SMS API
TIGER_SMS_API_KEY="your-tiger-sms-api-key"
TIGER_SMS_BASE_URL="https://api.tiger-sms.com"

# EPay Payment (可选)
EPAY_URL="https://epay.example.com"
EPAY_PID="your-epay-pid"
EPAY_KEY="your-epay-key"

# Solana USDT Payment (可选)
SOLANA_RECEIVE_ADDRESS="your-solana-wallet-address"

# SMTP Email
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"
SMTP_FROM="noreply@example.com"
